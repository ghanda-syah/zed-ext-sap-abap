; Indent after block-opening keywords
(class_definition) @indent
(class_implementation) @indent
(interface_definition) @indent
(method_definition) @indent
(method_implementation) @indent
(form_definition) @indent
(function_module) @indent
(if_statement) @indent
(elseif_clause) @indent
(else_clause) @indent
(case_statement) @indent
(when_clause) @indent
(do_statement) @indent
(while_statement) @indent
(loop_statement) @indent
(try_statement) @indent
(catch_clause) @indent
(cleanup_clause) @indent
(select_statement) @indent
